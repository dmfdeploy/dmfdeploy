---
import BaseLayout from '../layouts/BaseLayout.astro';

const tiers = [
  { name: 'Contributor', amount: '€1,000' },
  { name: 'Builder', amount: '€5,000' },
  { name: 'Sustaining sponsor', amount: '€15,000' },
  { name: 'Founding sponsor', amount: '€25,000+' },
];
---

<BaseLayout
  page="sponsor"
  title="Become a founding sponsor — dmfdeploy"
  description="Support open engineering for a shared foundation for dynamic media. Explore proposed annual sponsorship levels, funding priorities and governance safeguards."
>
  <section class="sponsor-hero gradient-field" aria-labelledby="sponsor-title">
    <div class="site-container sponsor-hero-grid">
      <div>
        <p class="eyebrow">Founding sponsorship · proposed</p>
        <h1 id="sponsor-title">Become a founding sponsor.</h1>
        <p>Support open engineering and documentation for dynamic media facilities.</p>
      </div>
      <aside class="programme-panel" aria-label="Programme status">
        <span class="status-tag status-tag--pending">Programme proposed</span>
        <h2>Sponsorship status</h2>
        <dl>
          <div><dt>Annual levels</dt><dd>Proposed</dd></div>
          <div><dt>Fiscal host</dt><dd>Unconfirmed</dd></div>
          <div><dt>Payment link</dt><dd>Not active</dd></div>
          <div><dt>Corporate invoices</dt><dd>Pending host</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <nav class="site-container sponsor-jump" aria-label="On this page">
    <a href="#why">01 / Why sponsor</a><a href="#priorities">02 / Priorities</a><a href="#levels">03 / Levels</a><a href="#independence">04 / Independence</a><a href="#finance">05 / Finance</a>
  </nav>

  <section class="section-shell" id="why" aria-labelledby="why-title">
    <div class="site-container">
      <p class="section-index">01 / Strategic value</p>
      <h2 class="section-heading" id="why-title">Shared engineering, open to the field.</h2>
      <p class="section-intro">Manufacturers can examine integration points, broadcasters can review the operational path, and integrators can contribute deployment experience.</p>
    </div>
  </section>

  <section class="section-shell" id="priorities" aria-labelledby="priorities-title">
    <div class="site-container">
      <p class="section-index">02 / Engineering priorities</p>
      <h2 class="section-heading" id="priorities-title">What founding support could fund.</h2>
      <p class="section-intro">Proposed milestones; scope and sequencing remain subject to public technical review.</p>
      <div class="priority-list">
        <article class="priority-row"><span class="eyebrow">v0.1 polish</span><div><h3>Reproduce the documented setup</h3><p>Harden bootstrap, installation and verification so an independent engineer can bring up the single-node prototype.</p></div></article>
        <article class="priority-row"><span class="eyebrow">v0.2</span><div><h3>Operate a workload as a team</h3><p>Develop a team console, nonblocking deployments and NMOS IS-05 switching for a multi-function workload.</p></div></article>
        <article class="priority-row"><span class="eyebrow">v0.3</span><div><h3>Plan before provisioning</h3><p>Explore workload and facility planning before resources are provisioned.</p></div></article>
        <article class="priority-row"><span class="eyebrow">Ongoing</span><div><h3>Document and validate in public</h3><p>Maintain architecture records, integration guidance, reproducible examples and community review.</p></div></article>
      </div>
      <p class="priority-note">Proposed future work; no delivery dates or funding commitments. See the <a class="text-link" href="https://github.com/dmfdeploy/dmfdeploy/blob/main/ROADMAP.md">public roadmap ↗</a>.</p>
    </div>
  </section>

  <section class="tiers-section gradient-field" id="levels" aria-labelledby="levels-title">
    <div class="site-container">
      <p class="section-index">03 / Proposed annual levels</p>
      <h2 class="section-heading" id="levels-title">Indicative annual contributions.</h2>
      <div class="tier-grid">
        {tiers.map((tier) => <article class="tier-row"><span class="tier-name">{tier.name}</span><strong>{tier.amount}</strong></article>)}
      </div>
      <p class="tier-note">Levels and recognition terms are proposals pending confirmation of the programme and fiscal host.</p>
    </div>
  </section>

  <section class="section-shell" id="independence" aria-labelledby="independence-title">
    <div class="site-container">
      <p class="section-index">04 / Governance &amp; independence</p>
      <h2 class="section-heading" id="independence-title">The mission stays open.</h2>
      <div class="governance-panel-grid">
        <article class="governance-panel"><span class="eyebrow">Current practice</span><h3>Community-led technical decisions</h3><p>Public discussion and RFCs; recorded architecture decisions; maintainer review and DCO sign-off. The code is Apache-2.0 licensed.</p></article>
        <article class="governance-panel governance-panel--proposal"><span class="eyebrow">Proposed · not ratified</span><h3>Founder-protected mission</h3><p>A mission charter would safeguard vendor neutrality and open participation. The charter and formal governance remain unratified.</p></article>
      </div>
      <p class="no-control"><span>Proposed sponsorship boundary</span>Funding would not buy a vote, veto, feature priority or control of technical decisions.</p>
    </div>
  </section>

  <section class="section-shell" id="finance" aria-labelledby="finance-title">
    <div class="site-container">
      <p class="section-index">05 / Financial transparency</p>
      <h2 class="section-heading" id="finance-title">A clear route for funds, once verified.</h2>
      <p class="section-intro">The fiscal host is unconfirmed; no payment route is active.</p>
      <div class="finance-grid">
        <article class="finance-item"><span class="eyebrow">Fiscal host</span><h3>Unconfirmed</h3><p>Host and terms will be named once verified.</p></article>
        <article class="finance-item"><span class="eyebrow">Open Collective</span><h3>Proposed</h3><p>Reporting depends on host and platform setup.</p></article>
        <article class="finance-item"><span class="eyebrow">Corporate invoicing</span><h3>Conditional</h3><p>Availability depends on the eventual fiscal arrangement.</p></article>
      </div>
    </div>
  </section>

  <section class="sponsor-close gradient-field" aria-labelledby="close-title">
    <div class="site-container sponsor-close-inner">
      <div><p class="section-index">Corporate inquiries</p><h2 id="close-title">Discuss sponsorship.</h2><p><a class="text-link" href="mailto:inquiries@dmfdeploy.io?subject=dmfdeploy%20founding%20sponsorship%20inquiry">inquiries@dmfdeploy.io ↗</a></p></div>
    </div>
  </section>
</BaseLayout>
