---
interface Props {
  variant?: 'hero' | 'band';
}

const { variant = 'hero' } = Astro.props;
---

<svg
  class={`orbit-field orbit-field--${variant}`}
  viewBox="0 0 1100 700"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g class="orbit-field__drift">
    <ellipse class="orbit-field__trace" cx="728" cy="326" rx="388" ry="183" transform="rotate(-27 728 326)" />
    <ellipse class="orbit-field__trace orbit-field__trace--bright" cx="728" cy="326" rx="294" ry="256" transform="rotate(24 728 326)" />
    <ellipse class="orbit-field__trace orbit-field__trace--dashed" cx="728" cy="326" rx="486" ry="104" transform="rotate(-14 728 326)" />
    <ellipse class="orbit-field__trace" cx="374" cy="506" rx="146" ry="40" transform="rotate(-24 374 506)" />
    <ellipse class="orbit-field__trace orbit-field__trace--bright" cx="1022" cy="118" rx="108" ry="31" transform="rotate(32 1022 118)" />
    <ellipse class="orbit-field__trace" cx="922" cy="590" rx="104" ry="29" transform="rotate(-35 922 590)" />
    <circle class="orbit-field__node" cx="391" cy="220" r="5" />
    <circle class="orbit-field__node orbit-field__node--warm" cx="1008" cy="249" r="7" />
    <circle class="orbit-field__node" cx="588" cy="575" r="4" />
  </g>
</svg>
