# dmfdeploy umbrella — CODEOWNERS
#
# The main-protection ruleset on `main` requires a code-owner review, so a PR
# that touches a path below needs approval from its owner before it merges.
#
# Every file matches a single rule (last match wins). The catch-all line
# at the top applies to anything not matched by a more specific rule.

# Default reviewer for the whole umbrella
*                              @dmfdeploy/maintainers

# Foundational architectural decisions
/docs/decisions/               @dmfdeploy/maintainers

# Architecture references (canonical)
/docs/architecture/            @dmfdeploy/maintainers

# Operational tools — high-leverage on every workflow
/bin/                          @dmfdeploy/maintainers

# Canonical agent skills — the instructions every agent reads (ADR-0042).
# .claude/skills/ and .qwen/skills/ are GENERATED views and gitignored, so a
# rule on them would not cover the source; this is the tracked one.
/.agents/                      @dmfdeploy/maintainers

# Agent runtime config — subagent definitions and harness settings, which also
# define what agents may do. (.claude/skills/ is gitignored; the rest is tracked.)
/.claude/                      @dmfdeploy/maintainers

# CI / GitHub workflows
/.github/                      @dmfdeploy/maintainers

# Surface files: what a first-time reader sees. These are owned by the
# maintainer account, so a change to the public face always gets a review.
# They come last because the last matching rule wins.
/README.md                     @dmfdeploy/maintainers
/CONTRIBUTING.md               @dmfdeploy/maintainers
/AGENTS.md                     @dmfdeploy/maintainers
/CLAUDE.md                     @dmfdeploy/maintainers
/ROADMAP.md                    @dmfdeploy/maintainers
/STATUS.md                     @dmfdeploy/maintainers
/docs/WORKING-MODEL.md         @dmfdeploy/maintainers
