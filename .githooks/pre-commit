#!/usr/bin/env bash
# .githooks/pre-commit — local pre-commit gates for the umbrella.
#
# Runs staged secret scans and CHECK-ONLY, path-scoped doc gates before
# allowing the commit. Never mutates or stages anything: on drift it
# refuses and points at bin/fix-docs.sh.
#
# Activate once per clone:
#   git config core.hooksPath .githooks
#   (or: bin/install-hooks.sh)
#
# Escape hatches:
#   STATUS_HOOK_SKIP=1 git commit ...    # skip umbrella doc refresh/check steps
#   git commit --no-verify ...           # bypass all hooks (use sparingly)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── Secret scanning (R1 §6 switchover: THIN CALLER of the shared library).
# The umbrella (and any repo carrying bin/dmf-scan) scans staged changes via
# the one implementation — manifest-driven grep pass + pinned gitleaks with
# the ephemeral merged config — under the HARDCODED pre-commit context.
# FAIL-CLOSED (§5.3): a missing private manifest refuses the commit; there is
# no public-only escape here (§5.4). Operators/agents: the private manifest
# lives at ~/.dmfdeploy/pattern-manifest.private.toml (see
# bin/migrate-private-manifest.py). This gate sits ABOVE the STATUS_HOOK_SKIP
# hatch — that hatch never skips secret scanning.
if [ -x "$REPO_ROOT/bin/dmf-scan" ]; then
    if ! "$REPO_ROOT/bin/dmf-scan" staged --repo "$REPO_ROOT" --context pre-commit; then
        echo "" >&2
        echo "[pre-commit] dmf-scan: staged changes refused (see class line above)" >&2
        echo "  LEAK_FOUND:    remove the value (true FP: adjust the manifest via review)" >&2
        echo "  CONFIG_ERROR:  fix the environment — never edit patterns to pass" >&2
        echo "  bypass (rare): git commit --no-verify" >&2
        exit 1
    fi
    # Generated-view drift (public region literal, private view redacted).
    if ! "$REPO_ROOT/bin/dmf-scan" check >/dev/null 2>&1; then
        echo "" >&2
        echo "[pre-commit] generated gitleaks views drifted from the manifests — refusing commit" >&2
        "$REPO_ROOT/bin/dmf-scan" check 2>&1 | sed 's/^/  /' >&2
        echo "  public: bin/gen-gitleaks-rules.py --emit (stage .gitleaks.toml)" >&2
        echo "  private: regenerate locally (bin/migrate-private-manifest.py --force --rewrite-legacy)" >&2
        exit 1
    fi
# Legacy fallback for component repos that share this hooksPath but do not
# carry the scan library yet (they keep the old two-pass gitleaks behavior
# until the #73 cross-repo distribution lands).
elif command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --no-banner --redact >/dev/null 2>&1; then
        echo "" >&2
        echo "[pre-commit] gitleaks: leak detected in staged changes — refusing commit" >&2
        echo "  inspect:        gitleaks protect --staged -v" >&2
        exit 1
    fi
    if [ -f "$REPO_ROOT/.gitleaks.local.toml" ]; then
        if ! gitleaks protect --staged --no-banner --redact \
                --config "$REPO_ROOT/.gitleaks.local.toml" >/dev/null 2>&1; then
            echo "" >&2
            echo "[pre-commit] gitleaks (operator-private rules): identity/topology literal in staged changes — refusing commit" >&2
            exit 1
        fi
    fi
elif [ "${GITLEAKS_HOOK_QUIET:-0}" != "1" ]; then
    echo "[pre-commit] WARN: gitleaks not installed — skipping secret scan." >&2
    echo "             brew install gitleaks (silence with GITLEAKS_HOOK_QUIET=1)" >&2
fi

# Live environment identifier (umbrella issue #361). Deliberately placed with
# the secret scans and ABOVE the STATUS_HOOK_SKIP hatch: this is a
# public-surface gate, not a doc-hygiene one, so the emergency hatch must not
# skip it. The identifier list is derived from live env state on every run —
# never typed in — so it follows env rotation instead of going stale.
if [ -x "$REPO_ROOT/bin/check-live-env-leak.sh" ]; then
    # Run ONCE, capturing output and status together. The earlier wiring ran a
    # silenced first pass and re-ran on failure — which discarded the script's
    # own skip announcement, so "no env store, gate skipped" printed nothing and
    # the bypass was silent, defeating the announce-don't-be-silent design.
    # The || arm keeps set -e from aborting on a non-zero gate status before
    # anything is printed — a silent refusal is as bad as a silent skip.
    _leak_rc=0
    _leak_out="$("$REPO_ROOT/bin/check-live-env-leak.sh" --staged 2>&1)" || _leak_rc=$?
    # Surface EVERY skip variant the gate can announce — "no env store" and
    # "holds no envs" are different messages, and matching only one made the
    # other a silent bypass. Clean runs stay quiet like the other gates.
    case "$_leak_out" in
        *"no env store"*|*"holds no envs"*|*"skipping"*) printf '%s\n' "$_leak_out" ;;
    esac
    if [ "$_leak_rc" -ne 0 ]; then
        echo "" >&2
        printf '%s\n' "$_leak_out" >&2
        echo "[pre-commit] live environment identifier gate refused the commit" >&2
        exit 1
    fi
fi

# Only fire the umbrella-specific bits when umbrella scripts exist. Component
# repos use the same hooksPath only if their operators opt in; we don't want to
# break them silently if they happen to share a config.
[ -x "$REPO_ROOT/bin/check-docs.sh" ] || exit 0

# Skip during rebase / merge / cherry-pick — generated-doc noise from the hook
# just confuses the operator there.
[ -d "$REPO_ROOT/.git/rebase-merge" ] && exit 0
[ -d "$REPO_ROOT/.git/rebase-apply" ] && exit 0
[ -f "$REPO_ROOT/.git/MERGE_HEAD" ] && exit 0
[ -f "$REPO_ROOT/.git/CHERRY_PICK_HEAD" ] && exit 0

[ "${STATUS_HOOK_SKIP:-0}" = "1" ] && {
    echo "[pre-commit] STATUS_HOOK_SKIP=1 — skipping umbrella doc refresh/check steps"
    exit 0
}

# ── The doc gates below are CHECK-ONLY and PATH-SCOPED. The hook never
# mutates or stages anything (the old auto-refresh once ate sibling-repo
# sections of SCRIPTS.md when run from a worktree); on drift it refuses and
# points at bin/fix-docs.sh. Each gate fires only when the staged paths can
# actually affect it, so code-only commits skip the doc machinery entirely.
# --no-renames: a rename must surface BOTH paths (as D+A) — with rename
# detection on, --name-only reports only the destination, so moving a file
# OUT of a watched path never fired its gate.
STAGED_PATHS="$(git diff --cached --name-only --no-renames --diff-filter=ACMRTD)"
touches() { printf '%s\n' "$STAGED_PATHS" | grep -qE "$1"; }
# Editing the hook itself re-arms every doc gate for this commit
# (a gate's implementation is part of its trigger).
HOOK_CHANGED=0
touches '^\.githooks/pre-commit$' && HOOK_CHANGED=1
gate_on() { [ "$HOOK_CHANGED" = 1 ] || touches "$1"; }
refuse() {  # refuse <label> <fix-hint> <recheck-cmd...>
    local label="$1" hint="$2"; shift 2
    echo "" >&2
    echo "[pre-commit] ${label} — refusing commit" >&2
    "$@" 2>&1 | sed 's/^/  /' >&2
    echo "  fix: ${hint}" >&2
    echo "  (STATUS_HOOK_SKIP=1 bypasses doc gates only — never secret scanning)" >&2
    exit 1
}

if gate_on '^(bin/|tests/|docs/SCRIPTS\.md)' && [ -x "$REPO_ROOT/bin/generate-scripts-catalog.sh" ]; then
    "$REPO_ROOT/bin/generate-scripts-catalog.sh" --check >/dev/null 2>&1 \
        || refuse "docs/SCRIPTS.md is stale" "bin/fix-docs.sh && git add docs/SCRIPTS.md" \
                  "$REPO_ROOT/bin/generate-scripts-catalog.sh" --check
fi

if gate_on '^(docs/plans/|bin/generate-plans-index\.sh$)' && [ -x "$REPO_ROOT/bin/generate-plans-index.sh" ]; then
    "$REPO_ROOT/bin/generate-plans-index.sh" --check >/dev/null 2>&1 \
        || refuse "docs/plans/INDEX.md is stale" "bin/fix-docs.sh && git add docs/plans/INDEX.md" \
                  "$REPO_ROOT/bin/generate-plans-index.sh" --check
fi

if gate_on '^(docs/|bin/check-docs\.sh$)' && [ -x "$REPO_ROOT/bin/check-docs.sh" ]; then
    "$REPO_ROOT/bin/check-docs.sh" >/dev/null 2>&1 \
        || refuse "check-docs: doc gate failed" "see findings above (frontmatter/links)" \
                  "$REPO_ROOT/bin/check-docs.sh"
fi

# Surface checks (size budgets, filenames, archive placement; #617). STRICT
# mode on the staged files only, so a commit is refused only for a problem in
# what it stages. CI runs the same checks on the whole tree.
if gate_on '^(README\.md|AGENTS\.md|STATUS\.md|docs/|bin/check-surface\.sh$|tests/surface/)' \
        && [ -x "$REPO_ROOT/bin/check-surface.sh" ]; then
    # Check the staged content, not the working-tree copy: export the staged
    # blobs to a temp dir and use that dir as the scan root, so each file keeps
    # its repo-relative path.
    SURFACE_ARGS=()
    SURFACE_PATHS=()
    while IFS= read -r p; do
        if git cat-file -e ":$p" 2>/dev/null; then SURFACE_PATHS+=("$p"); fi
    done < <(printf '%s\n' "$STAGED_PATHS" | grep -E '^(README\.md|AGENTS\.md|STATUS\.md|docs/)' || true)
    if [ ${#SURFACE_PATHS[@]} -gt 0 ]; then
        SURFACE_TMP="$(mktemp -d)"
        trap 'rm -rf "$SURFACE_TMP"' EXIT
        git checkout-index --prefix="$SURFACE_TMP/" -- "${SURFACE_PATHS[@]}"
        for p in "${SURFACE_PATHS[@]}"; do SURFACE_ARGS+=(--file "$SURFACE_TMP/$p"); done
        "$REPO_ROOT/bin/check-surface.sh" --strict --root "$SURFACE_TMP" "${SURFACE_ARGS[@]}" >/dev/null 2>&1 \
            || refuse "check-surface: staged files break a surface rule" \
                      "see findings above (budgets, filenames, archive placement)" \
                      "$REPO_ROOT/bin/check-surface.sh" --strict --root "$SURFACE_TMP" "${SURFACE_ARGS[@]}"
    fi
fi

# Working-model block sync (umbrella issue #32): copies of the agent-context
# block must match docs/templates/working-model-block.md byte-for-byte.
if gate_on '^(CLAUDE\.md|AGENTS\.md|QWEN\.md|docs/templates/working-model-block\.md|bin/check-working-model-sync\.sh$)' \
        && [ -x "$REPO_ROOT/bin/check-working-model-sync.sh" ]; then
    "$REPO_ROOT/bin/check-working-model-sync.sh" --umbrella-only >/dev/null 2>&1 \
        || refuse "working-model block drifted" "edit docs/templates/working-model-block.md, then re-paste copies" \
                  "$REPO_ROOT/bin/check-working-model-sync.sh" --umbrella-only
fi

# Skills sync (ADR-0042): per-agent .claude/.qwen skill views are generated from
# .agents/skills/ and must stay gitignored — nothing generated or un-promoted
# (the _inbox) may be committed.
if gate_on '^(\.agents/|\.claude/|\.qwen/|bin/sync-skills\.sh$)' && [ -x "$REPO_ROOT/bin/sync-skills.sh" ]; then
    "$REPO_ROOT/bin/sync-skills.sh" --check --umbrella-only >/dev/null 2>&1 \
        || refuse "skills out of sync with canonical" "bin/sync-skills.sh --apply, then stage and retry" \
                  "$REPO_ROOT/bin/sync-skills.sh" --check --umbrella-only
fi

exit 0
